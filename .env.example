# Copie este arquivo para ".env" apenas se for rodar LOCALMENTE (para testes).
# No Render, essas variáveis são configuradas na aba "Environment" do serviço,
# não neste arquivo.

# Connection string do Postgres (Supabase: Settings > Database > Connection string,
# use a versão "URI" / "Transaction pooler"). Copie exatamente como o Supabase mostra,
# substituindo [YOUR-PASSWORD] pela senha do banco que você definiu ao criar o projeto.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Porta do servidor (o Render define isso sozinho — não precisa mexer em produção)
PORT=3000

# Opcional: pasta com as fotos originais do backup (photos/arrivals/<id>/...jpg),
# só faz sentido rodando localmente — em produção no Render as fotos não persistem
# entre reinicializações (armazenamento efêmero no plano gratuito).
# PHOTOS_DIR=../photos
